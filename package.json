{
  "name": "tesserax-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Tesserax Wallet: the web wallet of Tesserax, with post-quantum ML-DSA-87 accounts, AI agent delegations, the agent registry, payment channels and the task market.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:extension": "tsc -p tsconfig.json --noEmit && tsx scripts/build-extension.ts",
    "build:desktop-web": "tsc -p tsconfig.json --noEmit && vite build --mode desktop",
    "desktop": "tauri dev",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@polkadot-api/metadata-builders": "0.15.2",
    "@polkadot-api/substrate-bindings": "0.21.2",
    "@scure/bip39": "2.4.0",
    "@tanstack/react-query": "5.104.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tesserax/sdk": "file:vendor/tesserax-sdk-0.1.0.tgz",
    "lucide-react": "1.60.0",
    "polkadot-api": "3.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "rxjs": "7.8.2",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
