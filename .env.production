# Public defaults of the builds for users (web, extension, desktop): the devnet and its public
# RPC, served with post-quantum TLS. `npm run dev` keeps .env. Users can change the node in the
# settings.
VITE_NODE_URL=wss://rpc.tesserax.app:21207
VITE_NETWORK=Development
VITE_EXPLORER_URL=https://explorer.tesserax.app
