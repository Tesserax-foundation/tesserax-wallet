{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tesserax Wallet",
  "mainBinaryName": "tesserax-wallet-desktop",
  "version": "../package.json",
  "identifier": "app.tesserax.wallet",
  "build": {
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist-desktop",
    "beforeDevCommand": "npx vite --mode desktop",
    "beforeBuildCommand": "npm run build:desktop-web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "worker-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws: wss: https://*.supabase.co",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "copyright": "Tesserax",
    "license": "Apache-2.0",
    "shortDescription": "Post-quantum wallet of Tesserax",
    "longDescription": "The wallet of Tesserax: ML-DSA-87 accounts, transfers, AI agent budgets, the agent registry, payment channels and the task market.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
