{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The wallet window: links open in the browser of the system.",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://localhost:*" }, { "url": "http://127.0.0.1:*" }]
    }
  ]
}
