# Node the wallet connects to by default; users can change it in the settings.
VITE_NODE_URL=ws://127.0.0.1:9944
# Name of the network shown in the header: Mainnet, Testnet or Development.
VITE_NETWORK=Development
# Explorer, for links to blocks and transactions.
VITE_EXPLORER_URL=http://localhost:5173
# Optional: the Supabase project of the explorer, read-only, for the transaction history.
VITE_EXPLORER_SUPABASE_URL=
VITE_EXPLORER_SUPABASE_KEY=
