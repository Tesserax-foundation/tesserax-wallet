# Network the wallet opens by default: Mainnet, Testnet or Development. Users choose another in
# the settings. The public endpoints of the mainnet and the testnet are built in.
VITE_NETWORK=Development

# The variables below change the endpoints of the default network. Those of another network take
# its name as prefix, such as VITE_TESTNET_NODE_URL or VITE_MAINNET_GENESIS.

# Node the wallet connects to; users can change it in the settings.
VITE_NODE_URL=ws://127.0.0.1:9944
# Explorer, for links to blocks and transactions.
VITE_EXPLORER_URL=http://localhost:5173
# Optional: faucet of a testnet, for the Get test TESS button.
VITE_FAUCET_URL=
# Optional: the Supabase project of the explorer, read-only, for the transaction history and a
# fast synchronization of the private balance.
VITE_EXPLORER_SUPABASE_URL=
VITE_EXPLORER_SUPABASE_KEY=
# Genesis hash the node must have (0x and 64 digits); the mainnet is offered once it is known.
VITE_GENESIS=
# Development only: one local EVM chain (anvil, chain id 31337, with the swap contract deployed by
# swaps/evm/deploy.sh of the chain) standing for Ethereum, Base and Arbitrum in the Market.
VITE_EVM_LOCAL_URL=
